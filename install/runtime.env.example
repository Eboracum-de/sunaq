# Service secrets / external credentials. Keep chmod 600.
NEO4J_PASSWORD=replace-me
RAG_ADMIN_USER=admin
RAG_ADMIN_PASSWORD=replace-me
PROVIDER_API_KEY=replace-me
RAG_INTERNAL_API_KEY=replace-me
RAG_PROVIDER_INTERNAL_KEY=replace-me

# User-facing provider gate. Fresh installs/updates enter maintenance mode first.
# Configure and verify the deployment before setting this to false.
RAG_MAINTENANCE_MODE=true

# External/model credentials. LLM_API_KEY is the default credential for
# planner/verifier/evidence/answer roles. A non-empty role-specific key below
# overrides it for that role; otherwise the role falls back to LLM_API_KEY.
# Model profiles may also name a custom secret through roles.<role>.api_key_env;
# add that KEY= value here when used.
LLM_API_KEY=
PLANNER_LLM_API_KEY=
VERIFIER_LLM_API_KEY=
EVIDENCE_LLM_API_KEY=
ANSWER_LLM_API_KEY=

# Optional non-answer backends/capabilities.
EMBEDDING_API_KEY=
GRAPH_ENTITY_API_KEY=
GRAPH_RELATION_API_KEY=
WEB_SEARCH_API_KEY=
WEB_LLM_API_KEY=

# Optional Elasticsearch authentication secret referenced by config.yaml.
ELASTICSEARCH_PASSWORD=

# Encrypted per-user credential store (Stage 1). The installer creates the key
# as root:rag 0640. Do not put the key itself in this file.
RAG_CREDENTIAL_MASTER_KEY_FILE=runtime/credential-master.key
RAG_CREDENTIAL_ENCRYPTION=required
