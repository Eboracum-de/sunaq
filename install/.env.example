# Docker stack settings. All backend ports bind to loopback; nginx is the only
# externally reachable component and uses host networking on Linux.
QDRANT_PORT=6333
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
OPENWEBUI_PORT=3000

# ERG resolver adapters. The gateway itself is a regular local component;
# external adapters remain opt-in and use file-backed secrets.
RESOLVER_NEO4J_ENABLED=false
RESOLVER_OPENREGISTER_ENABLED=false
RESOLVER_OPENPLZ_ENABLED=false

# Beta image pins. These are immutable digest-qualified references. Update only
# deliberately and rerun the blank-VM acceptance test before changing them.
NGINX_IMAGE=nginx:1.30.4-alpine3.24@sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46
QDRANT_IMAGE=qdrant/qdrant:v1.19.0@sha256:057ee3a8da769fe7310dd3537b4dc7583bf87a95ce8ac43c0af5a46bc580d1fc
NEO4J_IMAGE=neo4j:5.26.29-community@sha256:d9dd3dc7d1c78fa959191ff02dbdcbefadceaf83eee23428fb92a58cac8ad3fe
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0@sha256:72c0ba641ba75e7aa52655cb242570906ececd09b1140fb736483038a22b3228

NEO4J_PASSWORD=replace-me
# Synced by install.sh from runtime.env; used only to seed OpenWebUI on first start.
OPENWEBUI_PROVIDER_API_KEY=replace-me
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m
