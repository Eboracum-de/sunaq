# AKI RAG Middleware provider example - 0.8.5-rc4.3
# Fresh installs copy this file to provider.env. Keep secrets in runtime.env.
# Canonical LLM settings. OLLAMA_* remain code-side legacy fallbacks only.

RAG_MIDDLEWARE_URL=http://127.0.0.1:8765

# Middleware API listener. Keep 127.0.0.1 unless /rag-admin/ or the API
# must be reachable from another host.
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8765

# OpenAI-compatible provider listener.
PROVIDER_HOST=127.0.0.1
PROVIDER_PORT=8766

# ---------------------------------------------------------------------------
# Answer / evidence / rewrite LLM
# ---------------------------------------------------------------------------
LLM_BACKEND=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna
FOLLOWUP_MODEL=gpt-5.6-luna
EVIDENCE_MODEL=gpt-5.6-luna
ANSWER_MODEL=gpt-5.6-luna
# Keep LLM/API credentials in runtime.env. LLM_API_KEY is intentionally not
# duplicated in this non-secret routing file.
LLM_VERIFY_TLS=true
# Alternative local/OpenAI-compatible deployment:
# LLM_BACKEND=openai
# LLM_BASE_URL=https://provider.example/v1
# LLM_MODEL=<provider-model>
# Supply LLM_API_KEY (and any role-specific API keys) via runtime.env.
# Graph entity/relation extraction has its own graph_* configuration in
# config.yaml. Automatic graph processing is off by default in RC3 because it
# can expose much larger document excerpts to a remote graph backend.
# LLM_CA_FILE=/etc/ssl/certs/my-private-ca.pem

# ---------------------------------------------------------------------------
# Optional role-specific LLM routing (RC3)
# ---------------------------------------------------------------------------
# Empty/unset values inherit the canonical LLM_* backend above. This allows a
# private local retrieval plane with remote semantic verification/answering, or
# any deliberate mix. Set *_LLM_SCOPE=local|remote only when auto-detection from
# the URL is not appropriate. If backend/base URL changes, set the role model too.
#
# PLANNER_LLM_BACKEND=ollama
# PLANNER_LLM_BASE_URL=http://127.0.0.1:11434
# PLANNER_LLM_MODEL=qwen3:4b
# PLANNER_LLM_API_KEY=
# PLANNER_LLM_VERIFY_TLS=true
# PLANNER_LLM_SCOPE=local
#
# VERIFIER_LLM_BACKEND=openai
# VERIFIER_LLM_BASE_URL=https://api.openai.com/v1
# VERIFIER_LLM_MODEL=gpt-5.6-luna
# VERIFIER_LLM_API_KEY=
# VERIFIER_LLM_VERIFY_TLS=true
# VERIFIER_LLM_SCOPE=remote
#
# EVIDENCE_LLM_BACKEND=openai
# EVIDENCE_LLM_BASE_URL=https://api.openai.com/v1
# EVIDENCE_LLM_MODEL=gpt-5.6-luna
#
# ANSWER_LLM_BACKEND=openai
# ANSWER_LLM_BASE_URL=https://api.openai.com/v1
# ANSWER_LLM_MODEL=gpt-5.6-luna
#
# Packaged SunaQ profiles use the SUNAQ_REMOTE_HARD_* trust-boundary caps.
# Fresh 0.8.6 installs leave the legacy REMOTE_* variables unset so the
# selected profile can use its documented budget. If a preserved 0.8.5
# provider.env explicitly sets REMOTE_*, those values remain effective as
# tighter caps until the administrator reviews/removes/raises them.
SUNAQ_REMOTE_HARD_MAX_CHARS_PER_DOCUMENT=8000
SUNAQ_REMOTE_HARD_MAX_TOTAL_CHARS=250000
SUNAQ_REMOTE_HARD_VERIFIER_MAX_CANDIDATES=50
SUNAQ_REMOTE_HARD_VERIFIER_MAX_CHARS_PER_DOCUMENT=6000
SUNAQ_REMOTE_HARD_ANSWER_MAX_DOCUMENTS=50

# Legacy/non-packaged compatibility defaults (optional explicit overrides):
# REMOTE_LLM_MAX_CHARS_PER_DOCUMENT=3000
# REMOTE_LLM_MAX_TOTAL_CHARS=20000
# REMOTE_VERIFIER_MAX_CANDIDATES=10
# REMOTE_VERIFIER_MAX_CHARS_PER_DOCUMENT=2000
# REMOTE_ANSWER_MAX_DOCUMENTS=8

# Normal answer generation.
ANSWER_THINKING=false
ANSWER_MIN_NUM_PREDICT_THINKING=2048

# Local alternative (administrator-managed Ollama):
# LLM_BACKEND=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen3:8b
# FOLLOWUP_MODEL=qwen3:8b
# EVIDENCE_MODEL=qwen3:8b
# ANSWER_MODEL=qwen3:8b
# ANSWER_THINKING=false

# ---------------------------------------------------------------------------
# Provider itself (OpenWebUI -> provider)
# ---------------------------------------------------------------------------
PROVIDER_MODEL_ID=nextcloud-hybrid-rag
PROVIDER_MODEL_NAME="SunaQ"
# PROVIDER_API_KEY is the installer primary client key in runtime.env.
# Each additional frontend must receive its own key via rag.provider_clients.

# ---------------------------------------------------------------------------
# Watchdog / generation
# ---------------------------------------------------------------------------
DEFAULT_TEMPERATURE=0.2
DEFAULT_NUM_PREDICT=2048
MAX_NUM_PREDICT=8192
MAX_NUM_CTX=32768
LLM_STREAM_MAX_SECONDS=180
ELASTIC_STREAM_MAX_SECONDS=360
LLM_STREAM_READ_TIMEOUT=90
STREAM_REASONING=true
REASONING_STREAM_FORMAT=tags
HTTP_TIMEOUT=300
AUX_MAX_NUM_PREDICT=400

# ---------------------------------------------------------------------------
# Retrieval / context / prompts
# ---------------------------------------------------------------------------
SEARCH_LIMIT=20
CONTEXT_MAX_CHARS=40000
PER_RESULT_MAX_CHARS=6000
QUERY_REWRITE_MODE=followup
# /new defines the context boundary; 0 means use the full active segment.
FOLLOWUP_HISTORY_MESSAGES=0
FOLLOWUP_HISTORY_MAX_CHARS=8000
LOG_RETRIEVAL_QUERY=true
ALLOW_GENERAL_KNOWLEDGE=false

PROMPT_DIR=./prompts
RAG_ANSWER_PROMPT_FILE=rag_answer.txt
DIRECT_PROMPT_FILE=direct.txt
FOLLOWUP_REWRITE_PROMPT_FILE=followup_rewrite.txt
NATURAL_INSTRUCTION_PROMPT_FILE=natural_instruction.txt
NATURAL_INSTRUCTION_MODE=on
NATURAL_INSTRUCTION_MAX_TOKENS=600
WEB_AFTER_QUERY_PROMPT_FILE=web_after_queries.txt
WEB_AFTER_QUERY_MAX_TOKENS=500
WEB_AFTER_CONTEXT_MAX_CHARS=12000
WEB_AFTER_MAX_QUERIES=3
EVIDENCE_DECISION_PROMPT_FILE=evidence_decision.txt
WEB_ANSWER_PROMPT_FILE=web_answer.txt

# ---------------------------------------------------------------------------
# Evidence / provenance / graph hook
# ---------------------------------------------------------------------------
# Legacy fallback only; the active SunaQ model is canonical.
EVIDENCE_DECISION_MODE=off
EVIDENCE_MAX_TOKENS=700
EVIDENCE_CONTEXT_MAX_CHARS=14000
EVIDENCE_PER_RESULT_MAX_CHARS=1600
# Legacy fallback only; the active SunaQ model retrieval_planner is canonical.
MAX_RETRIEVAL_ROUNDS=2
ENTITY_RECALL_BACKOFF_ENABLED=true

RESEARCH_LOG_ENABLED=true
RESEARCH_LOG_DB=research.sqlite
RESEARCH_LOG_STORE_ANSWER=false

GRAPH_EVIDENCE_HOOK_ENABLED=true
GRAPH_EVIDENCE_HOOK_TIMEOUT=30
GRAPH_EVIDENCE_HOOK_MAX_DOCUMENTS=8

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
API_LOG_LEVEL=INFO
PROVIDER_LOG_LEVEL=INFO
WORKER_LOG_LEVEL=INFO
WEB_LOG_LEVEL=INFO
SYNC_LOG_LEVEL=INFO
# Chatty dependency logs (Neo4j/Cypher, HTTP clients, Qdrant) are WARNING by default.
# Set an individual logger to DEBUG only for diagnostics.
THIRD_PARTY_LOG_LEVEL=WARNING
NEO4J_LOG_LEVEL=WARNING
HTTPX_LOG_LEVEL=WARNING
URLLIB3_LOG_LEVEL=WARNING
QDRANT_LOG_LEVEL=WARNING
